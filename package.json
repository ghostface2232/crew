{
  "name": "crew",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.board.json && tsc -p tsconfig.native.json --noEmit",
    "test": "node --test test/*.test.ts",
    "dev:board": "vite",
    "build:board": "vite build",
    "test:e2e": "npm run build:board && NODE_ENV=development vite build --outDir ../../.e2e/development/board/dist --emptyOutDir --logLevel warn && playwright test",
    "build:desktop": "npm run build:board && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && open native/build/Crew.app",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "test:desktop": "npm run build:desktop && node scripts/smoke-desktop.mjs",
    "test:native": "node scripts/test-native.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
