{
  "description": "Crew installs these in the user's Codex hooks file, each command running its launcher. They report a Codex lead session's activity to the Crew status board, give it the user's shared crew instructions and Crew's pending news, and offer news at the end of each turn. The daemon wakes an idle Codex lead itself.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/context.ts\"", "timeout": 10 },
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/wake.ts\" context start", "timeout": 30 },
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/wake.ts\" context", "timeout": 5 },
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }] }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/wake.ts\" stop-json", "timeout": 5 },
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 5 }
        ]
      }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 3 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/bridge/report.ts\" codex", "timeout": 3 }] }
    ]
  }
}
